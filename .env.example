# ══════════════════════════════════════════════════════════════
# ARGUS-PRISM V3 — environment template
# Copy to .env and fill in. NEVER commit a real .env.
# ══════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────
APP_NAME=ARGUS-PRISM
APP_VERSION=3.0.0
ENVIRONMENT=development           # development | staging | production
DEBUG=true
API_PREFIX=/api/v1

# ─── Datastores ───────────────────────────────────────────────
# When these are unreachable in development, the backend falls back to a
# local SQLite file + in-memory event bus (see app/core/config.py).
POSTGRES_URL=postgresql+psycopg://prism:prism@localhost:5432/prismdb
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=prism1234
REDIS_URL=redis://localhost:6379/0

# ─── Auth / JWT ───────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-change-me-please-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
MFA_TOKEN_TTL_MINUTES=5
MFA_ISSUER=ARGUS-PRISM
MFA_RATE_LIMIT_ATTEMPTS=5
MFA_RATE_LIMIT_WINDOW_SECONDS=300

# ─── Google OAuth (bank domain) ───────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
OAUTH_ALLOWED_DOMAIN=              # e.g. unionbankofindia.bank — empty = allow any

# ─── Signing / integrity (Law 3: never crosses the API boundary) ─
# Package-signing + audit-HMAC keys live here ONLY. Generate real ones.
PACKAGE_SIGNING_KEY=dev-only-package-signing-key-change-me
AUDIT_HMAC_KEY=dev-only-audit-hmac-key-change-me

# ─── PII tokenization ─────────────────────────────────────────
TOKENIZATION_BACKEND=aes_siv
PII_TOKENIZATION_KEY=              # 32-byte urlsafe base64; empty = derive dev key
DEVICE_HASH_SALT=dev-device-salt-change-me

# ─── WarmthScore thresholds (0–100) ───────────────────────────
WARMTH_THRESHOLD_WATCH=40
WARMTH_THRESHOLD_WARMING=55
WARMTH_THRESHOLD_HOT=70
WARMTH_THRESHOLD_CRITICAL=85
WARMTH_THRESHOLD_IMMINENT=95
TAINT_MAX_HOPS=4
RECRUITER_MIN_ACCOUNTS=5

# ─── Simulator ────────────────────────────────────────────────
SIM_DEFAULT_SEED=20260707
SIM_TICK_MS=1000                  # emit cadence for the live faucet

# ─── Chatbot (Ollama — local on-prem OR Ollama Cloud) ─────────
# Local:  OLLAMA_URL=http://localhost:11434   OLLAMA_MODEL=gemma:2b   (no key)
# Cloud:  OLLAMA_URL=https://ollama.com        OLLAMA_MODEL=gemma4:31b-cloud   + key
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma:2b
OLLAMA_API_KEY=                   # Ollama Cloud API key — set in .env only, never commit
ASSISTANT_ENABLED=false           # true once Ollama (local or cloud) is reachable

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
